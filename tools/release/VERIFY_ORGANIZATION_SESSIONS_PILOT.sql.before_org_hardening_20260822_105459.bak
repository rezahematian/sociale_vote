-- Social Vote Organizations + Sessions Pilot — READ-ONLY VERIFY
-- No data is modified by this file.

-- 1) Required tables and RLS.
select
  c.relname as table_name,
  c.relrowsecurity as rls_enabled
from pg_class c
join pg_namespace n on n.oid = c.relnamespace
where n.nspname = 'public'
  and c.relname in (
    'organization_entities',
    'organization_memberships',
    'organization_workspaces',
    'live_sessions',
    'live_questions',
    'live_options',
    'live_access_tokens',
    'live_participant_credentials',
    'live_token_question_uses',
    'live_open_question_uses',
    'live_ballots',
    'organization_session_audit',
    'live_verified_reports'
  )
order by c.relname;

-- 2) Public branding bucket only; writes remain policy-controlled.
select id, public, file_size_limit, allowed_mime_types
from storage.buckets
where id = 'organization-media';

-- 3) Critical functions must be SECURITY DEFINER.
select
  p.proname,
  p.prosecdef as security_definer,
  pg_get_function_identity_arguments(p.oid) as args,
  p.proacl as privileges
from pg_proc p
join pg_namespace n on n.oid = p.pronamespace
where n.nspname = 'public'
  and p.proname in (
    'organization_get_mine',
    'organization_bootstrap_from_verified_profile',
    'organization_update_profile',
    'organization_set_media_url',
    'session_create',
    'session_generate_tokens',
    'session_open',
    'session_question_open',
    'session_public_join',
    'session_public_state',
    'session_public_vote',
    'session_public_results',
    'session_close',
    'session_verified_report'
  )
order by p.proname;

-- 4) Expected public-vs-organizer privilege matrix.
select
  has_function_privilege('anon', 'public.session_public_join(text,text)', 'EXECUTE') as anon_join,
  has_function_privilege('anon', 'public.session_public_state(text,text)', 'EXECUTE') as anon_state,
  has_function_privilege('anon', 'public.session_public_vote(text,text,uuid,uuid[])', 'EXECUTE') as anon_vote,
  has_function_privilege('anon', 'public.session_public_results(text,text,uuid)', 'EXECUTE') as anon_results,
  has_function_privilege('anon', 'public.session_verified_report(uuid)', 'EXECUTE') as anon_verify,
  has_function_privilege('anon', 'public.session_create(text,text,text,text,integer)', 'EXECUTE') as anon_create,
  has_function_privilege('authenticated', 'public.session_create(text,text,text,text,integer)', 'EXECUTE') as auth_create,
  has_function_privilege('authenticated', 'public.session_generate_tokens(uuid,integer)', 'EXECUTE') as auth_generate_tokens;

-- Expected above:
-- anon_join/state/vote/results/verify = true
-- anon_create = false
-- auth_create/auth_generate_tokens = true
-- Authorization INSIDE organizer functions still requires active verified organization membership.

-- 5) Direct table access must remain unavailable to app roles.
select
  has_table_privilege('anon', 'public.live_ballots', 'SELECT,INSERT,UPDATE,DELETE') as anon_ballots_direct,
  has_table_privilege('authenticated', 'public.live_ballots', 'SELECT,INSERT,UPDATE,DELETE') as auth_ballots_direct,
  has_table_privilege('anon', 'public.live_access_tokens', 'SELECT,INSERT,UPDATE,DELETE') as anon_tokens_direct,
  has_table_privilege('authenticated', 'public.live_access_tokens', 'SELECT,INSERT,UPDATE,DELETE') as auth_tokens_direct,
  has_table_privilege('authenticated', 'public.organization_entities', 'INSERT,UPDATE,DELETE') as auth_org_direct_write;

-- Expected: all false.

-- 6) Privacy invariant: ballot and one-vote ledgers have no per-vote timestamp
-- and ballots have no participant/token/credential foreign-key columns.
select
  exists (
    select 1 from information_schema.columns
    where table_schema='public' and table_name='live_ballots'
      and column_name in ('user_id','token_id','credential_id','participant_id','created_at','submitted_at')
  ) as ballot_has_forbidden_link_or_timestamp,
  exists (
    select 1 from information_schema.columns
    where table_schema='public' and table_name='live_token_question_uses'
      and column_name in ('used_at','created_at','submitted_at')
  ) as token_use_has_timestamp,
  exists (
    select 1 from information_schema.columns
    where table_schema='public' and table_name='live_open_question_uses'
      and column_name in ('used_at','created_at','submitted_at')
  ) as open_use_has_timestamp;

-- Expected: false / false / false.

-- 7) Billing is hard OFF for every workspace created by this pilot.
select plan_key, commercial_mode, billing_enabled, count(*)
from public.organization_workspaces
group by plan_key, commercial_mode, billing_enabled
order by plan_key;

-- Expected for pilot-created workspaces: plan_key=pilot, commercial_mode=pilot_free,
-- billing_enabled=false. No payment provider is activated by this migration.
