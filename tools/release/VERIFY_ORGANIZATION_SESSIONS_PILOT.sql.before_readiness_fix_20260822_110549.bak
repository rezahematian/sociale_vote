-- Social Vote Organizations + Sessions Pilot — READ-ONLY VERIFY V2
-- 2026-08-22
-- Expected: every row in the first result set has pass = true.

with
required_tables(table_name) as (
  values
    ('organization_entities'),
    ('organization_memberships'),
    ('organization_workspaces'),
    ('live_sessions'),
    ('live_questions'),
    ('live_options'),
    ('live_access_tokens'),
    ('live_participant_credentials'),
    ('live_token_question_uses'),
    ('live_open_question_uses'),
    ('live_ballots'),
    ('organization_session_audit'),
    ('live_verified_reports')
),
critical_functions(function_name) as (
  values
    ('organization_get_mine'),
    ('organization_bootstrap_from_verified_profile'),
    ('organization_update_profile'),
    ('organization_set_media_url'),
    ('organization_member_role'),
    ('organization_user_can_manage'),
    ('organization_user_can_operate'),
    ('session_create'),
    ('session_generate_tokens'),
    ('session_open'),
    ('session_question_open'),
    ('session_question_close'),
    ('session_public_join'),
    ('session_public_state'),
    ('session_public_vote'),
    ('session_public_results'),
    ('session_close'),
    ('session_verified_report'),
    ('sessions_retention_cleanup')
),
checks as (
  select
    '01_required_tables_13'::text as check_name,
    (
      select count(*) = 13
      from pg_class c
      join pg_namespace n on n.oid = c.relnamespace
      join required_tables r on r.table_name = c.relname
      where n.nspname = 'public' and c.relkind = 'r'
    ) as pass,
    (
      select count(*)::text || '/13 tables present'
      from pg_class c
      join pg_namespace n on n.oid = c.relnamespace
      join required_tables r on r.table_name = c.relname
      where n.nspname = 'public' and c.relkind = 'r'
    ) as detail

  union all
  select
    '02_rls_all_required_tables',
    not exists (
      select 1
      from required_tables r
      left join pg_class c on c.relname = r.table_name
      left join pg_namespace n on n.oid = c.relnamespace and n.nspname = 'public'
      where c.oid is null or n.oid is null or not c.relrowsecurity
    ),
    'RLS must be enabled on all 13 required tables'

  union all
  select
    '03_direct_table_access_denied',
    not exists (
      select 1
      from required_tables r
      cross join (values ('anon'), ('authenticated')) roles(role_name)
      cross join (values ('SELECT'), ('INSERT'), ('UPDATE'), ('DELETE')) privs(priv_name)
      where coalesce(pg_catalog.has_table_privilege(
        roles.role_name,
        to_regclass('public.' || r.table_name),
        privs.priv_name
      ), false)
    ),
    'anon/authenticated must have no direct SELECT/INSERT/UPDATE/DELETE on pilot tables'

  union all
  select
    '04_branding_bucket',
    exists (
      select 1
      from storage.buckets b
      where b.id = 'organization-media'
        and b.public
        and b.file_size_limit = 8388608
        and b.allowed_mime_types @> array['image/jpeg','image/png','image/webp']::text[]
    ),
    'organization-media public read; 8 MiB; jpeg/png/webp'

  union all
  select
    '05_storage_write_policies',
    (
      select count(*) = 3
      from pg_policies p
      where p.schemaname = 'storage'
        and p.tablename = 'objects'
        and p.policyname in (
          'organization_media_insert_manager',
          'organization_media_update_manager',
          'organization_media_delete_manager'
        )
        and 'authenticated' = any(p.roles)
    ),
    'exact manager INSERT/UPDATE/DELETE policies must exist for organization-media'

  union all
  select
    '06_critical_functions_security_definer',
    not exists (
      select 1
      from critical_functions f
      left join pg_proc p on p.proname = f.function_name
      left join pg_namespace n on n.oid = p.pronamespace and n.nspname = 'public'
      where p.oid is null or n.oid is null or not p.prosecdef
    ),
    'all listed organization/session RPCs must be SECURITY DEFINER'

  union all
  select
    '07_security_definer_safe_search_path',
    not exists (
      select 1
      from pg_proc p
      join pg_namespace n on n.oid = p.pronamespace
      where n.nspname = 'public'
        and p.prosecdef
        and p.proname ~ '^(organization_|session_|sessions_|_session_)'
        and coalesce(array_to_string(p.proconfig, ','), '')
          not like '%search_path=pg_catalog, public, extensions%'
    ),
    'all pilot SECURITY DEFINER functions use controlled pg_catalog, public, extensions path'

  union all
  select
    '08_public_schema_create_denied',
    not pg_catalog.has_schema_privilege('anon', 'public', 'CREATE')
      and not pg_catalog.has_schema_privilege('authenticated', 'public', 'CREATE'),
    'anon/authenticated cannot create objects in schema public'

  union all
  select
    '09_public_rpc_matrix',
    coalesce(pg_catalog.has_function_privilege('anon', 'public.session_public_join(text,text)', 'EXECUTE'), false)
      and coalesce(pg_catalog.has_function_privilege('anon', 'public.session_public_state(text,text)', 'EXECUTE'), false)
      and coalesce(pg_catalog.has_function_privilege('anon', 'public.session_public_vote(text,text,uuid,uuid[])', 'EXECUTE'), false)
      and coalesce(pg_catalog.has_function_privilege('anon', 'public.session_public_results(text,text,uuid)', 'EXECUTE'), false)
      and coalesce(pg_catalog.has_function_privilege('anon', 'public.session_verified_report(uuid)', 'EXECUTE'), false)
      and not coalesce(pg_catalog.has_function_privilege('anon', 'public.session_create(text,text,text,text,integer)', 'EXECUTE'), false)
      and coalesce(pg_catalog.has_function_privilege('authenticated', 'public.session_create(text,text,text,text,integer)', 'EXECUTE'), false)
      and coalesce(pg_catalog.has_function_privilege('authenticated', 'public.session_generate_tokens(uuid,integer)', 'EXECUTE'), false),
    'public participant RPCs true; anon organizer create false; authenticated organizer create/token true'

  union all
  select
    '10_ballot_no_identity_or_timestamp',
    not exists (
      select 1 from information_schema.columns
      where table_schema = 'public' and table_name = 'live_ballots'
        and column_name in (
          'user_id','token_id','credential_id','participant_id',
          'created_at','submitted_at','voted_at'
        )
    )
    and not exists (
      select 1
      from pg_constraint con
      join pg_class rel on rel.oid = con.conrelid
      join pg_namespace n on n.oid = rel.relnamespace
      where n.nspname = 'public'
        and rel.relname = 'live_ballots'
        and con.contype = 'f'
        and pg_get_constraintdef(con.oid) ~* '(user|token|credential|participant)'
    ),
    'ballot stores only question/options/receipt; no identity/token/credential/per-ballot timestamp'

  union all
  select
    '11_one_vote_ledgers_no_timestamp',
    not exists (
      select 1 from information_schema.columns
      where table_schema = 'public'
        and table_name in ('live_token_question_uses','live_open_question_uses')
        and column_name in ('used_at','created_at','submitted_at','voted_at')
    ),
    'one-vote ledgers contain no timing column'

  union all
  select
    '12_token_and_secret_hash_only',
    not exists (
      select 1 from information_schema.columns
      where table_schema = 'public'
        and (
          (table_name = 'live_access_tokens' and column_name in ('token','plaintext_token','token_plain'))
          or
          (table_name = 'live_participant_credentials' and column_name in ('secret','participant_secret','plaintext_secret'))
        )
    ),
    'no plaintext token/participant secret columns are persisted'

  union all
  select
    '13_verified_report_immutable_trigger',
    exists (
      select 1
      from pg_trigger t
      join pg_class c on c.oid = t.tgrelid
      join pg_namespace n on n.oid = c.relnamespace
      where n.nspname = 'public'
        and c.relname = 'live_verified_reports'
        and t.tgname = 'live_verified_reports_immutable'
        and not t.tgisinternal
        and t.tgenabled <> 'D'
    ),
    'immutable UPDATE/DELETE trigger enabled on live_verified_reports'

  union all
  select
    '14_organizer_only_report_not_public',
    position(
      'results_visibility <> ''organizer_only'''
      in pg_get_functiondef('public._session_public_detail_json(uuid)'::regprocedure)
    ) > 0
    and position(
      'v_results_visibility = ''organizer_only'''
      in pg_get_functiondef('public.session_verified_report(uuid)'::regprocedure)
    ) > 0
    and position(
      '_session_assert_operator'
      in pg_get_functiondef('public.session_verified_report(uuid)'::regprocedure)
    ) > 0,
    'organizer_only hides report_id publicly and report RPC requires organizer authorization'

  union all
  select
    '15_retention_cleanup_service_role_only',
    not coalesce(pg_catalog.has_function_privilege('anon', 'public.sessions_retention_cleanup()', 'EXECUTE'), false)
      and not coalesce(pg_catalog.has_function_privilege('authenticated', 'public.sessions_retention_cleanup()', 'EXECUTE'), false)
      and coalesce(pg_catalog.has_function_privilege('service_role', 'public.sessions_retention_cleanup()', 'EXECUTE'), false),
    'retention cleanup denied to anon/authenticated and executable by service_role'

  union all
  select
    '16_deleted_account_trigger',
    exists (
      select 1
      from pg_trigger t
      join pg_class c on c.oid = t.tgrelid
      join pg_namespace n on n.oid = c.relnamespace
      where n.nspname = 'auth'
        and c.relname = 'users'
        and t.tgname = 'social_vote_org_deleted_auth_user_guard'
        and not t.tgisinternal
        and t.tgenabled <> 'D'
    ),
    'Auth deletion trigger revokes organization membership and restricts ownerless workspace'

  union all
  select
    '17_no_deleted_active_membership',
    not exists (
      select 1
      from public.organization_memberships om
      join app_private.account_controls ac on ac.user_id = om.user_id
      where ac.status = 'deleted'
        and om.status = 'active'
        and not exists (select 1 from auth.users au where au.id = om.user_id)
    ),
    'deleted Auth accounts must have no active organization membership'

  union all
  select
    '18_no_active_ownerless_workspace',
    not exists (
      select 1
      from public.organization_workspaces ow
      where ow.status = 'active'
        and not exists (
          select 1
          from public.organization_memberships om
          where om.organization_id = ow.organization_id
            and om.membership_role = 'owner'
            and om.status = 'active'
        )
    ),
    'workspace without active owner must be restricted, not active'

  union all
  select
    '19_billing_hard_off_constraint',
    exists (
      select 1
      from pg_constraint con
      join pg_class c on c.oid = con.conrelid
      join pg_namespace n on n.oid = c.relnamespace
      where n.nspname = 'public'
        and c.relname = 'organization_workspaces'
        and con.conname = 'organization_workspaces_pilot_billing_hard_off'
        and con.convalidated
    )
    and not exists (
      select 1
      from public.organization_workspaces
      where plan_key <> 'pilot'
         or commercial_mode <> 'pilot_free'
         or billing_enabled
    ),
    'pilot/free/false enforced by CHECK and current data'

  union all
  select
    '20_media_url_same_project_only',
    position(
      'rbuzlrclwhxaigkgndrb.supabase.co/storage/v1/object/public/organization-media/'
      in pg_get_functiondef('public.organization_set_media_url(uuid,text,text)'::regprocedure)
    ) > 0
    and not exists (
      select 1
      from public.organization_entities oe
      where (oe.logo_url is not null and oe.logo_url not like
        'https://rbuzlrclwhxaigkgndrb.supabase.co/storage/v1/object/public/organization-media/' || oe.id::text || '/logo.%')
         or (oe.cover_url is not null and oe.cover_url not like
        'https://rbuzlrclwhxaigkgndrb.supabase.co/storage/v1/object/public/organization-media/' || oe.id::text || '/cover.%')
    ),
    'cover/logo URLs cannot point to arbitrary external origins'

  union all
  select
    '21_controlled_one_credential_per_token',
    exists (
      select 1
      from pg_indexes
      where schemaname = 'public'
        and tablename = 'live_participant_credentials'
        and indexname = 'live_participant_credentials_one_per_token_idx'
        and indexdef ilike '%unique%'
    )
    and not exists (
      select token_id
      from public.live_participant_credentials
      where token_id is not null
      group by token_id
      having count(*) > 1
    ),
    'controlled token can have at most one current browser credential'

  union all
  select
    '22_public_join_basic_throttle',
    position(
      'v_recent_joins >= 120'
      in pg_get_functiondef('public.session_public_join(text,text)'::regprocedure)
    ) > 0
    and position(
      'v_active_credentials >= v_session.max_participants'
      in pg_get_functiondef('public.session_public_join(text,text)'::regprocedure)
    ) > 0,
    'open-anonymous join keeps max_participants and adds a session-level burst limit; not a one-person-one-vote guarantee'

  union all
  select
    '23_public_session_status_gate',
    position('ow.status = ''active''' in pg_get_functiondef('public.session_public_join(text,text)'::regprocedure)) > 0
    and position('oe.verification_status = ''verified''' in pg_get_functiondef('public.session_public_join(text,text)'::regprocedure)) > 0
    and position('ow.status = ''active''' in pg_get_functiondef('public.session_public_vote(text,text,uuid,uuid[])'::regprocedure)) > 0
    and position('oe.verification_status = ''verified''' in pg_get_functiondef('public.session_public_vote(text,text,uuid,uuid[])'::regprocedure)) > 0,
    'public join/vote paths require active workspace + verified organization'

  union all
  select
    '24_session_branding_present',
    position('organization_name' in pg_get_functiondef('public._session_public_detail_json(uuid)'::regprocedure)) > 0
      and position('organization_logo_url' in pg_get_functiondef('public._session_public_detail_json(uuid)'::regprocedure)) > 0
      and position('organization_cover_url' in pg_get_functiondef('public._session_public_detail_json(uuid)'::regprocedure)) > 0,
    'participant session read model contains organization name/logo/cover'

  union all
  select
    '25_session_close_idempotent',
    position(
      'v_session.status = ''closed'''
      in pg_get_functiondef('public.session_close(uuid)'::regprocedure)
    ) > 0
    and position(
      'return v_report_id'
      in pg_get_functiondef('public.session_close(uuid)'::regprocedure)
    ) > 0,
    'repeating close returns existing report without duplicate close audit'
)
select
  check_name,
  pass,
  detail,
  count(*) filter (where not pass) over () as failed_checks,
  case when bool_and(pass) over () then 'PASS' else 'FAIL' end as overall_status
from checks
order by check_name;

-- SOCIAL VOTE TEST ACCOUNT READINESS — READ ONLY.
-- Matches the operational mailbox and/or visible Social Vote organization name.
with target as (
  select
    au.id as user_id,
    au.email,
    pu.display_name,
    up.actor_type,
    up.organization_name,
    up.verified_at,
    up.is_verified,
    ac.status as account_status
  from auth.users au
  left join public.users pu on pu.id = au.id
  left join public.user_profiles up on up.id = au.id
  left join app_private.account_controls ac on ac.user_id = au.id
  where lower(coalesce(au.email, '')) = 'socialvote@hotmail.com'
     or lower(coalesce(pu.display_name, '')) = 'social vote'
     or lower(coalesce(up.organization_name, '')) = 'social vote'
), org_context as (
  select
    t.*,
    om.organization_id,
    om.membership_role,
    om.status as membership_status,
    oe.public_name,
    oe.verification_status as organization_verification_status,
    ow.status as workspace_status,
    ow.plan_key,
    ow.commercial_mode,
    ow.billing_enabled
  from target t
  left join public.organization_memberships om
    on om.user_id = t.user_id and om.status = 'active'
  left join public.organization_entities oe on oe.id = om.organization_id
  left join public.organization_workspaces ow on ow.organization_id = oe.id
)
select
  user_id,
  email,
  display_name,
  actor_type,
  organization_name,
  verified_at,
  is_verified,
  account_status,
  organization_id,
  membership_role,
  membership_status,
  public_name,
  organization_verification_status,
  workspace_status,
  plan_key,
  commercial_mode,
  billing_enabled,
  case
    when organization_id is not null
      and membership_status = 'active'
      and organization_verification_status = 'verified'
      and workspace_status = 'active'
      and plan_key = 'pilot'
      and commercial_mode = 'pilot_free'
      and billing_enabled = false
      then 'WORKSPACE_READY'
    when account_status = 'active'
      and actor_type = 'organization'
      and nullif(btrim(coalesce(organization_name, '')), '') is not null
      and verified_at is not null
      and coalesce(is_verified, false)
      then 'READY_FOR_BOOTSTRAP'
    else 'NOT_READY'
  end as social_vote_org_test_state
from org_context
order by email nulls last;
